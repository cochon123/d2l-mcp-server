# D2L Brightspace configuration
D2L_HOST=learn.ul.ie

# Default course ID (optional) - if set, you don't need to specify orgUnitId in every request
D2L_COURSE_ID=68929

# Directories that may contain assignment upload files.
# Separate multiple paths with ":" on macOS/Linux or ";" on Windows.
D2L_UPLOAD_ROOTS=/path/to/your/projects

# Maximum upload size in bytes (default: 100 MiB)
D2L_MAX_UPLOAD_BYTES=104857600
